# Copia este archivo como `.env` para trabajar en tu computador.
# En el hosting (Cloudflare Pages) se ponen como variables de entorno, con estos mismos nombres.
# Los dos valores salen de Supabase: Project Settings -> API.
# Son claves públicas, pensadas para el navegador. NUNCA pongas aquí la service_role ni la contraseña de la base de datos.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon-o-publishable
